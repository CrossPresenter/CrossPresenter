{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossPresenter",
  "version": "1.0.1",
  "identifier": "app.crosspresenter.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CrossPresenter",
        "width": 1600,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": true,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src *",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$CACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cpshow"
        ],
        "name": "CrossPresenter Show",
        "description": "CrossPresenter service archive",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2RjBEQUI2MjkyQzk4ODAKUldTQW1Dd3B0dHJ3eHV2SDBlQzhFZ1BLSTlnb1pCM3JoU1RmTE1scWsyQ3RnN3pOS1ZvV0FmY0gK",
      "endpoints": [
        "https://github.com/CrossPresenter/CrossPresenter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
